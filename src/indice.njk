---
layout: base.njk
permalink: /indice/
pageTitle: Índice
bodyClass: toc-page
eleventyExcludeFromCollections: true
---
{%- from "picture.njk" import picture -%}
<main class="toc" id="main">
  <h1>Índice</h1>
  <ol class="toc-list">
  {%- for ch in chapters %}
    {%- set entry = media[ch.slug + "/" + ch.cover] if (ch.cover and ch.kind != "teaser") else null %}
    {%- set thumb = picset.pick(entry, 480) if entry else null %}
    <li class="toc-item toc-{{ ch.kind }}">
      <a class="toc-row" href="{{ ch.url }}">
        {%- if thumb %}
        <span class="toc-thumb">{{ picture(thumb, "Portada: " + ch.title, "96px", false) }}</span>
        {%- else %}
        <span class="toc-thumb toc-thumb-empty" aria-hidden="true"></span>
        {%- endif %}
        <span class="toc-text">
          <span class="toc-label">{{ ch.label }}</span>
          <span class="toc-title">{{ ch.title }}</span>
          {%- if ch.dateText and ch.kind != "teaser" %}
          <span class="toc-date">{{ ch.dateText }}</span>
          {%- endif %}
        </span>
      </a>
    </li>
  {%- endfor %}
  </ol>
  <nav class="pager" aria-label="Navegación entre páginas">
    <a class="toc" href="/">Portada</a>
  </nav>
</main>
