<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Administrador · Nuestra historia</title>
<meta name="robots" content="noindex,nofollow,noarchive">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#f4ead7">
<link rel="icon" href="/assets/icon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/admin/admin.css">
<script type="module" src="/admin/main.js"></script>
</head>
<body>
<section id="auth" class="panel" aria-labelledby="auth-title">
  <h1 id="auth-title">Administrador del álbum</h1>
  <p id="auth-intro">Cargando…</p>
  <form id="auth-form" novalidate>
    <div class="field" id="token-field" hidden>
      <label for="token">Token de GitHub</label>
      <input id="token" name="token" type="password" autocomplete="off" autocapitalize="off" spellcheck="false">
      <p class="hint">Se guarda cifrado en este dispositivo con tu contraseña.</p>
    </div>
    <div class="field">
      <label for="password" id="password-label">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password">
      <p class="hint" id="password-hint" hidden>Elige una contraseña de al menos 8 caracteres.</p>
    </div>
    <p id="auth-error" class="error" role="alert"></p>
    <button id="auth-submit" class="btn primary" type="submit" disabled>Entrar</button>
  </form>
  <button id="forget" class="btn link" type="button" hidden>Olvidar este dispositivo</button>
</section>
<div id="app" hidden></div>
</body>
</html>
