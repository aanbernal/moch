{
  "name": "album-site",
  "version": "1.0.0",
  "private": true,
  "description": "Álbum digital (sitio estático con Eleventy)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "media": "node scripts/media.mjs",
    "open-items": "node scripts/open-items.mjs",
    "guard": "node scripts/guard.mjs",
    "seed": "node scripts/seed.mjs",
    "preview": "node scripts/serve.mjs",
    "dev": "node scripts/media.mjs && eleventy --serve",
    "test": "node --test test/",
    "verify": "node scripts/verify-dist.mjs",
    "verify:browser": "STRICT_SEED=1 node scripts/verify-browser.mjs",
    "e2e": "STRICT_SEED=1 node scripts/e2e-admin.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.8",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "fast-check": "4.10.2",
    "playwright-core": "1.65.0",
    "sharp": "0.35.5"
  }
}
